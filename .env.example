# ==========================================================
# AI Commercial Court Research Engine - Environment Config
# ==========================================================

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-court-ai-secret-key-change-in-production

# Server Port
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/court_research_db

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
ALLOWED_EXTENSIONS=pdf

# AI Vector Embeddings
# Fast, lightweight model running efficiently on CPU (~80MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=uploads/vector_index.faiss
CHUNK_MAP_PATH=uploads/chunk_mapping.json

# Text Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Optional LLM Configuration (Set if you have an API key; otherwise graceful fallback is used)
# Supported options: "none", "gemini", "openai"
LLM_PROVIDER=none
LLM_API_KEY=
